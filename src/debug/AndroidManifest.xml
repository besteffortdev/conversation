<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- debug builds: simulates an MDM's app config from adb. DUMP is held by the shell,
             not by apps. See docs/app-config.md -->
        <receiver
            android:name="eu.siacs.conversations.services.AppConfigDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="eu.siacs.conversations.DEBUG_APP_CONFIG" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
